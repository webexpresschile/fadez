---
import site from '../data/site.json';
const { brand, seo } = site;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{seo.title}</title>
  <meta name="description" content={seo.description}/>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Montserrat:wght@400;500;600;700;900&display=swap" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="/fadez/favicon.svg">
  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>
